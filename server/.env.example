# Copy to .env and fill in.

# Ollama runs locally on this laptop.
OLLAMA_URL=http://localhost:11434
# Vision model. qwen2.5vl:7b needs ~8 GB RAM/VRAM; qwen3.5:4b (vision + chat, CPU-friendly) or qwen2.5vl:3b on a weaker laptop.
OLLAMA_MODEL=qwen2.5vl:7b
# Coach model. Empty = reuse OLLAMA_MODEL (one download, less RAM). For better coaching on a stronger
# laptop you can pull a text model, e.g. qwen2.5:7b, and set it here.
OLLAMA_CHAT_MODEL=

# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY allows only ~10 requests/hour, so get a key).
USDA_API_KEY=

# Any long random string. Put the same value in the app: Food -> Settings -> Shared token.
SNAPSHOT_TOKEN=

# Thinking models: false is much faster. How long Ollama keeps the model loaded after a request.
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
