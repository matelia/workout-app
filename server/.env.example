# Copy to .env and fill in.

# Ollama runs locally on this laptop.
OLLAMA_URL=http://localhost:11434
# Vision model. qwen2.5vl:7b needs ~8 GB RAM/VRAM; use qwen2.5vl:3b on a weaker laptop.
OLLAMA_MODEL=qwen2.5vl:7b

# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY allows only ~10 requests/hour, so get a key).
USDA_API_KEY=

# Any long random string. Put the same value in the app: Food -> Settings -> Shared token.
SNAPSHOT_TOKEN=
