{
  "expo": {
    "name": "Workout",
    "slug": "workout-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workoutapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.matin.workoutapp",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "ts.net": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes and take meal or label photos.",
          "microphonePermission": "Record an optional voice memo with your daily check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a meal or nutrition label photo.",
          "cameraPermission": "Take a meal or nutrition label photo.",
          "microphonePermission": "Record an optional voice memo with your daily check-in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID keeps your Mind tab private."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record an optional voice memo with your daily check-in.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Read your weight and body composition (e.g. from your Renpho scale) to show trends in Progress.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
